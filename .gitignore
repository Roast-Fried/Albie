test_screenshots.zip

# 로컬 빌드 산출물 zip (재생성 가능 — repo 용량 회피)
dist/

# Environment — .env 와 .env.example 은 빈 placeholder 템플릿으로 커밋합니다
# (flutter_dotenv asset 이라 파일이 없으면 빌드 실패 → fresh clone 보호).
# 실제 비밀 값(특히 GEMINI_API_KEY)은 .env.local 에 두면 git 추적되지 않습니다.
.env.local
.env.*.local

# Android release signing secrets
android/key.properties
android/app/upload-keystore.jks
android/app/*.jks
android/app/*.keystore

# Session checkpoint (temporary artifact)
checkpoint.md

# Build artifacts (Android)
android/build/

