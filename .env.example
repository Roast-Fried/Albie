# 알비(Albi) 환경 변수 템플릿
# ─────────────────────────────────────────────────────────────
# 이 파일을 `.env` 로 복사한 뒤 값을 채우면 해당 기능이 활성화됩니다.
# 값을 비워 두면 앱은 기존 로컬 전용 동작을 그대로 유지합니다(dormant).
#
# 활성화 후 적용하려면 앱을 다시 빌드/실행하세요.

# ── Supabase 클라우드 백업·동기화 (선택) ──
# Supabase 프로젝트 > Settings > API 에서 확인.
# anon key 는 클라이언트 공개 키(RLS 로 데이터 보호)라 노출되어도 안전합니다.
# 설정 가이드: docs/supabase-setup.md  (테이블 생성 SQL: docs/supabase-schema.sql)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Gemini AI 기본 키 (선택) ──
# 비밀 키이므로 커밋 금지. 가능하면 앱 내 설정 > AI 설정에서 입력하세요.
# 여기에 값을 넣으면 인앱 키가 없을 때 빌드 기본 키로 사용됩니다.
GEMINI_API_KEY=
